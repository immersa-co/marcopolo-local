# Copy to config/deployment.env. The image archives are GitHub Release assets.
# Each local image name is used with imagePullPolicy=Never, so Kubernetes never
# contacts a container registry.

POC_NAMESPACE=marcopolo-poc
WEB_BASE_URL=http://localhost:8000

# The native WorkOS fallback derives this slug from a Wells Fargo email domain.
POC_TENANT=wellsfargo-com
SOPS_PGP_FINGERPRINT=A3793925F10A42B5E04468F69496E56DF93AF4E6
PGP_PRIVATE_KEY_FILE="REPLACE_WITH_ABSOLUTE_PATH_TO_PRIVATE_ASC_KEY"
PGP_PASSPHRASE_FILE=

# All archives are public GitHub Release assets built for Apple Silicon.
MARCOPOLO_ARCHIVE_URL=https://github.com/immersa-co/REPLACE_WITH_RELEASE_REPOSITORY/releases/download/REPLACE_WITH_RELEASE_TAG/marcopolo-api-REPLACE_WITH_RELEASE_TAG-arm64.tar.gz
MARCOPOLO_ARCHIVE_SHA256=REPLACE_WITH_ARCHIVE_SHA256
MARCOPOLO_IMAGE=marcopolo-poc/marcopolo-api:REPLACE_WITH_RELEASE_TAG

MPROXY_ARCHIVE_URL=https://github.com/immersa-co/REPLACE_WITH_RELEASE_REPOSITORY/releases/download/REPLACE_WITH_RELEASE_TAG/mproxy-REPLACE_WITH_RELEASE_TAG-arm64.tar.gz
MPROXY_ARCHIVE_SHA256=REPLACE_WITH_ARCHIVE_SHA256
MPROXY_IMAGE=marcopolo-poc/mproxy:REPLACE_WITH_RELEASE_TAG

EXECUTOR_ARCHIVE_URL=https://github.com/immersa-co/REPLACE_WITH_RELEASE_REPOSITORY/releases/download/REPLACE_WITH_RELEASE_TAG/marcopolo-user-REPLACE_WITH_RELEASE_TAG-arm64.tar.gz
EXECUTOR_ARCHIVE_SHA256=REPLACE_WITH_ARCHIVE_SHA256
EXECUTOR_IMAGE=marcopolo-poc/marcopolo-user:REPLACE_WITH_RELEASE_TAG

# Existing Colima profile that Docker CLI uses. This deployment creates no
# macOS filesystem mounts; durable data lives in the K3s local-path volume.
COLIMA_PROFILE=default
